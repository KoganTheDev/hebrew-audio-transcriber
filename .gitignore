# Project Specific
whisper_models/
diarization_models/

# Generated transcripts. Same reasoning as the media block below - a transcript
# of a real conversation is as sensitive as the recording it came from, and this
# repo is public. The pattern has to track config.OUTPUT_FILENAME_TEMPLATE:
# output is now "<audio stem>_transcription.html" beside the audio, which the
# old "transcription*.txt" rule no longer matches. The .txt rule is kept so
# transcripts left over from before the HTML switch stay ignored too.
transcription*.txt
*_transcription.html

# Media. Never commit recordings - this repo is public, and the audio it
# processes is real conversations. Keep this list in sync with
# config.SUPPORTED_FORMATS; *.m4a in particular was missing while
# mp4a_test/ already held ~18 MB of real recordings.
*.mp4
*.m4a
*.m4v
*.wav
*.mp3
*.ogg
*.mkv
*.flac

# Local audio fixtures used for accuracy evaluation (see tests/eval/).
# Named by DIRECTORY, not just by the extension rules above: the extension
# list only catches the formats it knows about, so one stray recording in a
# container nobody thought to list (or a .zip/.txt export beside it) would
# still be stageable out of a directory full of real conversations. Naming
# the directory closes that hole for everything inside it at once.
mp4a_test/
mp3_test/
eval_output/

# Full-size vista originals, as downloaded. Only the processed, downscaled
# WebP versions under speech_to_text/core/assets/vistas/ are tracked and
# shipped - the originals are tens of megabytes and serve no purpose in the
# repo once they have been converted.
vistas_source/

# The user's own term list is personal vocabulary, not project content.
# hebrew_terms.example.txt is the tracked template.
hebrew_terms.txt

# Environment Variables
.env
.env.local

# OS
Thumbs.db
.DS_Store

# Logs
*.log
launcher-log.txt
